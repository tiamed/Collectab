DATABASE_URL=postgresql://postgres:postgres@localhost:5432/collectab
BETTER_AUTH_SECRET=change-this-to-a-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=*
TRUSTED_ORIGINS=
PORT=3001

# 用户角色：guest（受限）| user | admin
DEFAULT_ROLE=guest
# 管理员用户 ID（逗号分隔），这些用户自动拥有管理员权限
ADMIN_USER_IDS=

# 注册模式：open（无邀请码可注册为 guest）| invite-only（仅邀请可注册）
INVITE_MODE=open

# 邮箱服务（可选）：配置后解锁密码重置邮件和私有邀请
RESEND_API_KEY=
RESEND_FROM_EMAIL=Collectab <noreply@collectab.app>

# 社交登录（可选）：配置后启用 Google OAuth
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# 速率限制
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=20
